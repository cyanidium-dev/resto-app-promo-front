# Copy to .env.local and fill in.
# With none of these set, the lead form still works in development: submissions
# are appended to .leads/leads.jsonl. In production the API refuses to accept a
# lead it cannot deliver, rather than showing a false success.

NEXT_PUBLIC_SITE_URL=https://mysanitrace.com

# --- Email (Resend) -------------------------------------------------------
# The sending domain needs SPF, DKIM and DMARC, otherwise auto-replies land in
# spam and the lead assumes the form is broken.
RESEND_API_KEY=
LEAD_TO_EMAIL=sales@mysanitrace.com
LEAD_FROM_EMAIL="MySaniTrace <noreply@mysanitrace.com>"

# --- Google Sheets --------------------------------------------------------
# Create a service account, then share the spreadsheet with its email address.
# GOOGLE_PRIVATE_KEY keeps its literal \n escapes — the code unescapes them.
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Leads!A:P
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
